PORT=4000
DATABASE_URL=postgresql://postgres:password@localhost:5432/ary_services
PG_POOL_MAX=10
PGSSL=false
CLIENT_ORIGIN=http://localhost:5173
# Generate unique random values (at least 32 characters); never reuse the examples.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
OTP_SHIELD_SECRET=replace-with-another-unique-random-secret-at-least-32-characters
# Admin is provisioned only when both values are configured.
ADMIN_NAME=ARY Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password

# Optional Twilio Verify integration for production SMS OTP.
# Required in production to send and verify real customer SMS codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional mobility fare estimates (LKR). Leave blank to keep estimates disabled.
RIDE_BASE_FARE_LKR=
RIDE_PER_KM_FARE_LKR=
RIDE_MIN_FARE_LKR=
DELIVERY_BASE_FARE_LKR=
DELIVERY_PER_KM_FARE_LKR=
DELIVERY_MIN_FARE_LKR=
